---
/**
 * Page Produits - Site de démonstration RedCMS
 */
import Layout from '../layouts/Layout.astro';
import { getPageContent } from '@redcms/core/content';

const pageData = await getPageContent('produits');
const content = pageData?.content || {};

const titre = content.titre || 'Nos Produits';
const description = content.description || '';
const produits = content.produits || [];

const cta = {
  titre: content.cta_titre || 'Besoin d\'aide ?',
  texte: content.cta_texte || '',
  bouton: content.cta_bouton || 'Contact',
  lien: content.cta_lien || '/contact',
};
---

<Layout title={pageData?.seo?.title || titre} description={pageData?.seo?.description || description}>
  
  <!-- Header Section -->
  <section class="page-header">
    <div class="container">
      <h1>{titre}</h1>
      {description && <p class="page-header__desc">{description}</p>}
    </div>
  </section>

  <!-- Products Grid -->
  <section class="products">
    <div class="container">
      {produits.length > 0 ? (
        <div class="products__grid">
          {produits.map((produit: any) => (
            <div class="product-card">
              {produit.badge && <span class="product-card__badge">{produit.badge}</span>}
              
              <div class="product-card__image-wrapper">
                {produit.image ? (
                  <img src={produit.image} alt={produit.nom} class="product-card__image" />
                ) : (
                  <div class="product-card__placeholder">
                    <span>📦</span>
                  </div>
                )}
              </div>

              <div class="product-card__content">
                <h3 class="product-card__title">{produit.nom}</h3>
                {produit.description && <p class="product-card__desc">{produit.description}</p>}
                
                <div class="product-card__footer">
                  <div class="product-card__price">
                    {produit.prix_barre && (
                      <span class="product-card__price-old">{produit.prix_barre}</span>
                    )}
                    <span class="product-card__price-current">{produit.prix || 'Prix sur demande'}</span>
                  </div>
                  
                  <div class="product-card__stock">
                    {produit.en_stock !== false ? (
                      <span class="stock stock--in">✓ En stock</span>
                    ) : (
                      <span class="stock stock--out">Rupture</span>
                    )}
                  </div>
                </div>

                {produit.lien && (
                  <a href={produit.lien} class="product-card__btn">
                    Voir le produit
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="products__empty">
          <span class="products__empty-icon">📦</span>
          <h3>Aucun produit</h3>
          <p>Les produits seront affichés ici une fois ajoutés via l'admin.</p>
          <a href="/admin/pages" class="btn btn-primary">Ajouter des produits</a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  {cta.titre && (
    <section class="cta">
      <div class="container">
        <h2>{cta.titre}</h2>
        {cta.texte && <p>{cta.texte}</p>}
        <a href={cta.lien} class="btn btn-primary btn-lg">{cta.bouton}</a>
      </div>
    </section>
  )}

</Layout>

<style>
  /* ============================================
     PAGE HEADER
     ============================================ */
  .page-header {
    padding: 80px 0 60px;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    text-align: center;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 16px;
  }

  .page-header__desc {
    font-size: 1.125rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ============================================
     PRODUCTS
     ============================================ */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .products {
    padding: 60px 0 100px;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
  }

  .product-card {
    position: relative;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-card__image-wrapper {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #f8fafc;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: #cbd5e1;
  }

  .product-card__content {
    padding: 24px;
  }

  .product-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 8px;
  }

  .product-card__desc {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .product-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-card__price-old {
    font-size: 0.8125rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .product-card__price-current {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
  }

  .stock {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .stock--in {
    background: #dcfce7;
    color: #16a34a;
  }

  .stock--out {
    background: #fee2e2;
    color: #dc2626;
  }

  .product-card__btn {
    display: block;
    width: 100%;
    padding: 12px;
    background: #1e293b;
    color: white;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .product-card__btn:hover {
    background: #6366f1;
  }

  /* Empty state */
  .products__empty {
    text-align: center;
    padding: 80px 20px;
    color: #64748b;
  }

  .products__empty-icon {
    font-size: 4rem;
    display: block;
    margin-bottom: 16px;
  }

  .products__empty h3 {
    font-size: 1.5rem;
    color: #1e293b;
    margin: 0 0 8px;
  }

  .products__empty p {
    margin: 0 0 24px;
  }

  /* ============================================
     CTA
     ============================================ */
  .cta {
    padding: 80px 0;
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    text-align: center;
  }

  .cta h2 {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin: 0 0 12px;
  }

  .cta p {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #6366f1;
    color: white;
  }

  .btn-primary:hover {
    background: #4f46e5;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
  }

  .btn-lg {
    padding: 18px 36px;
    font-size: 1.125rem;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .page-header {
      padding: 60px 0 40px;
    }

    .products {
      padding: 40px 0 60px;
    }

    .products__grid {
      gap: 20px;
    }
  }
</style>
