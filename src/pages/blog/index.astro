---
import Layout from '../../layouts/Layout.astro';
import { getAllArticles } from '@redcms/core/loader';

const articles = await getAllArticles();
---

<Layout title="Blog" description="Tous nos articles">
  <div class="blog-page">
    <header class="blog-header">
      <h1>Blog</h1>
      <p>Découvrez nos derniers articles</p>
    </header>
    
    <div class="articles-grid">
      {articles.map((article) => (
        <article class="article-card">
          {article.featuredImage && (
            <a href={`/blog/${article.slug}`} class="article-image">
              <img src={article.featuredImage} alt={article.title} loading="lazy" />
            </a>
          )}
          <div class="article-content">
            <div class="article-meta">
              {article.category && (
                <a href={`/blog/categorie/${article.category.slug}`} class="category">
                  {article.category.name}
                </a>
              )}
              {article.publishedAt && (
                <time datetime={article.publishedAt}>
                  {new Date(article.publishedAt).toLocaleDateString('fr-FR', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                  })}
                </time>
              )}
            </div>
            
            <h2>
              <a href={`/blog/${article.slug}`}>{article.title}</a>
            </h2>
            
            {article.excerpt && <p class="excerpt">{article.excerpt}</p>}
            
            {article.author && (
              <div class="author">
                {article.author.avatar && (
                  <img src={article.author.avatar} alt={article.author.name} class="author-avatar" />
                )}
                <span>{article.author.name}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .blog-header p {
    color: #666;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .article-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    transition: box-shadow 0.2s;
  }

  .article-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .article-image {
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-content {
    padding: 1.5rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
  }

  .category {
    background: #f3f4f6;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    text-decoration: none;
    color: #1a1a1a;
    font-weight: 500;
  }

  time {
    color: #666;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: #666;
  }

  .excerpt {
    color: #666;
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
