---
import '@redcms/admin/styles/admin.css';
import { PageEditor } from '@redcms/admin/components';

export const prerender = false;

const { id } = Astro.params;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Éditer page | RedCMS</title>
  </head>
  <body>
    <PageEditor client:load pageId={id} />
  </body>
</html>
